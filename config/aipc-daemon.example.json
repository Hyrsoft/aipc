{
  "bind": "0.0.0.0:8080",
  "worker_path": "media_worker",
  "web_dir": "../www",
  "data_dir": "../data",
  "runtime_dir": "/tmp/aipc-rust",
  "seed_config": "../config/media_worker.json",
  "autostart": true,
  "startup_timeout_ms": 15000,
  "stop_timeout_ms": 5000,
  "max_restarts": 5,
  "restart_window_sec": 300,
  "preview": {
    "enabled": true,
    "max_clients": 5,
    "max_frame_bytes": 4194304,
    "max_audio_frame_bytes": 65536,
    "broadcast_capacity": 32
  },
  "recording": {
    "enabled": true,
    "directory": "../recordings",
    "allowed_roots": ["../recordings"],
    "queue_capacity": 256,
    "max_duration_sec": 3600,
    "max_file_bytes": 2147483648,
    "min_free_bytes": 67108864,
    "max_export_files": 100
  },
  "rtsp": {
    "enabled": true,
    "bind": "0.0.0.0:8554",
    "path": "/live",
    "max_clients": 4,
    "mtu": 1200
  }
}
