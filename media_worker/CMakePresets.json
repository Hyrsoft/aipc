{
  "version": 3,
  "configurePresets": [
    {
      "name": "cross-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "${sourceDir}/cmake/toolchain-luckfox-pico.cmake",
      "cacheVariables": {
        "MEDIA_WORKER_BUILD_RUNTIME": "ON",
        "MEDIA_WORKER_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "Debug",
      "inherits": "cross-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "Release",
      "inherits": "cross-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "HostDebug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "MEDIA_WORKER_BUILD_RUNTIME": "OFF",
        "MEDIA_WORKER_BUILD_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "Debug", "configurePreset": "Debug" },
    { "name": "Release", "configurePreset": "Release" },
    { "name": "HostDebug", "configurePreset": "HostDebug" }
  ],
  "testPresets": [
    {
      "name": "HostDebug",
      "configurePreset": "HostDebug",
      "output": { "outputOnFailure": true }
    }
  ]
}

